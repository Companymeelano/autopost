# ——— PanahFit API — نمونه تنظیمات (فایل .env کنار package.json بسازید) ———
# سرور
PORT=8787
DATA_DIR=data
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_STRONG   # فقط هنگام ساخت اولین کاربر (dev: 12345)
#SEED_DEMO_USERS=1   # ساخت حساب‌های نمایشی editor/finance برای تست نقش‌ها
BACKUP_KEEP=14
#CSP_FRAME_ANCESTORS=none   # توصیه production: "none" (پیش‌فرض self برای پیش‌نمایش‌های iframe‌دار)

# هوش مصنوعی — هر LLM سازگار با OpenAI (OpenAI/Groq/Ollama/...)
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

# درگاه پرداخت زرین‌پال (بدون این، حالت demo داخلی فعال است)
#ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
#ZARINPAL_MOBILE=09120000000

# انتشار خودکار پست‌ها در کانال تلگرام (اختیاری)
#TELEGRAM_BOT_TOKEN=123456:ABC...
#TELEGRAM_CHAT_ID=@panahfit

