# نمونه .htaccess برای هاردنینگ کنار Passenger (اختیاری)
# دسترسی مستقیم به پوشه داده‌ها را ببندید (db/کانفیگ/مدیا محرمانه):
RedirectMatch 404 ^/data(/|$)
<IfModule mod_headers.c>
  Header set Referrer-Policy "same-origin"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
# فشرده‌سازی و کش استاتیک
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
